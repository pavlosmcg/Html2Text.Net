<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Html2Text.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../LICENSE.txt" Pack="true" PackagePath="" />
    <None Include="../README.md" Pack="true" PackagePath="" />
    <None Include="../icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <PropertyGroup>
    <PackageId>Html2Text.Net</PackageId>
    <Version>0.1.0</Version>
    <Authors>pavlosmcg</Authors>
    <Description>Converts HTML to plain text with sensible formatting.</Description>
    <PackageProjectUrl>https://github.com/pavlosmcg/Html2Text.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pavlosmcg/Html2Text.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

</Project>
